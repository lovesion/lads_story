{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LADS daily story front matter",
  "type": "object",
  "required": ["id", "title", "fandom", "character", "world", "relationship_stage", "characters", "tags", "length", "created_at", "generation_seed"],
  "properties": {
    "id": {"type": "string", "pattern": "^[0-9]{11}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 80},
    "fandom": {"const": "恋与深空"},
    "character": {"enum": ["qinche", "xiyi"]},
    "world": {"enum": ["canon", "if", "modern"]},
    "relationship_stage": {"enum": ["first_meet", "close", "dating", "married"]},
    "characters": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "tags": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "length": {"const": "short"},
    "created_at": {"type": "string", "format": "date"},
    "summary": {"type": "string", "maxLength": 160},
    "generation_seed": {"type": "object", "required": ["scene", "emotion", "conflict"], "properties": {"scene": {"type": "string"}, "emotion": {"type": "string"}, "conflict": {"type": "string"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
